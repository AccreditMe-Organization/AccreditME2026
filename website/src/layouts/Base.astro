---
// Every page's shell (ACC-213): <html lang dir>, the canonical on
// www.accreditme.app, hreflang alternates for both languages (and x-default →
// English), the favicon from the mark, and the one stylesheet.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { strings, type Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** This page's path in English and in Arabic, each ending in "/". */
  paths: { en: string; ar: string };
  /** False for a page no one should link to as canonical (the 404s). */
  canonical?: boolean;
}

const { lang, title, description, paths, canonical = true } = Astro.props;
const t = strings[lang];
const site = 'https://www.accreditme.app';
const here = paths[lang];
---

<!doctype html>
<html lang={lang} dir={t.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={`${site}${here}`} />}
    {canonical && <link rel="alternate" hreflang="en" href={`${site}${paths.en}`} />}
    {canonical && <link rel="alternate" hreflang="ar" href={`${site}${paths.ar}`} />}
    {canonical && <link rel="alternate" hreflang="x-default" href={`${site}${paths.en}`} />}
    <link rel="icon" type="image/png" href="/accreditme-mark.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <Header lang={lang} otherPath={paths[t.languageSwitch.otherLang]} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
