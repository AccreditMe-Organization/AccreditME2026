# AccreditMe — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/accreditme

# -----------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------
BETTER_AUTH_SECRET=changeme-minimum-32-chars
JWT_SECRET=changeme-minimum-32-chars
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# -----------------------------------------------------------------------
# AWS S3 (default storage provider)
# -----------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AccreditMe's own bucket (ACC-177). Region decided: eu-central-1 for now.
# Left blank: S3 is not provisioned, and a placeholder would become a setting
# nobody chose. With any of the four blank, uploads are refused with
# "File storage isn't set up yet" — never a default.
AWS_REGION=
AWS_S3_BUCKET=
# Optional: an S3-compatible endpoint instead of AWS (local testing against
# MinIO, a Tier 2/3 install), usually with path-style addressing.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=
# Optional: offer the local-folder provider; a tenant's root must sit inside it.
LOCAL_STORAGE_BASE=
# Tier 2/3 only: allow a customer's MinIO on a private network, over http.
STORAGE_ALLOW_PRIVATE_ENDPOINTS=
# Per-file upload cap in MB; 25 when unset.
MAX_UPLOAD_MB=

# -----------------------------------------------------------------------
# AI — Anthropic (default AI provider)
# -----------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------
# Email — Resend
# -----------------------------------------------------------------------
RESEND_API_KEY=
# The sender on the domain Resend has verified (ACC-130). No fallback: unset,
# every email job fails with a named error and nothing is sent.
RESEND_FROM_EMAIL=noreply@accreditme.app

# -----------------------------------------------------------------------
# Payments — Stripe
# -----------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------
# Redis (BullMQ job queues)
# -----------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ACC-92 — does THIS process run the queue workers?
#
# Leave unset locally. `REDIS_URL` points at a SHARED Redis, so a backend
# started on a laptop with workers on competes with the deployment for its
# scheduled jobs — SLA sweeps, Setup health — and the work silently gets done
# by whichever machine happens to be running. Starting the API for ninety
# seconds is enough for a tick to land inside the session.
#
# Only the exact string `true` enables them.
#
# A DEPLOYMENT MUST SET THIS. Without it nothing runs the scheduled work at
# all. The app says which side of the gate it is on at startup, and logs an
# ERROR when a process that looks like a deployment has workers disabled.
# RUN_WORKERS=true

# -----------------------------------------------------------------------
# ClamAV (virus scanning sidecar)
# -----------------------------------------------------------------------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# -----------------------------------------------------------------------
# Error tracking — Sentry
# -----------------------------------------------------------------------
SENTRY_DSN=

# -----------------------------------------------------------------------
# Encryption (used for encrypting tenant provider secrets at rest)
# Must be 32 bytes hex — generate with: openssl rand -hex 32
# -----------------------------------------------------------------------
ENCRYPTION_KEY=

# -----------------------------------------------------------------------
# Platform
# -----------------------------------------------------------------------
# A mailbox you own. `npm run seed:demo` creates the platform administrator
# with it and refuses to run without it (ACC-130) — it used to guess
# admin@accreditme.com, a domain that is not ours.
PLATFORM_ADMIN_EMAIL=
# Bare host tenant subdomains sit under. REQUIRED — the API refuses to start
# without it. Emailed links are https://{slug}.{APP_BASE_DOMAIN}/... (ACC-158).
APP_BASE_DOMAIN=accreditme.app
# Development only: when set, emailed links are http://{slug}.localhost:4200/...
# (ACC-139), so a local invitation opens the local frontend on the right
# organisation. Must be exactly http(s)://localhost[:port] — 127.0.0.1 and
# [::1] are refused, since no subdomain can go in front of them. Leave it unset
# on any deployed service.
# APP_LINK_ORIGIN=http://localhost:4200
# The API's own origin — Better Auth's base URL (ACC-148). REQUIRED: the API
# refuses to start without it. Exactly an origin (no path), over https, or http
# for localhost only. Railway: https://accreditme2026-production.up.railway.app,
# then https://api.accreditme.app once ACC-130 moves the API there.
API_ORIGIN=http://localhost:3000
# Exact frontend origin — required for httpOnly-cookie CORS (Step 9). No
# wildcard: browsers reject credentials:true CORS responses with origin: *.
# Every tenant's own https://{slug}.{APP_BASE_DOMAIN} is allowed beside it
# (ACC-139). Locally the dev server proxies /api, so pages on {slug}.localhost
# call the API same-origin and need no CORS at all.
FRONTEND_URL=http://localhost:4200
PORT=3000
NODE_ENV=development
