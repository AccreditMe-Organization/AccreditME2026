// AccreditMe — Prisma Schema
// Single source of truth for the entire database.
// After ANY change: npx prisma migrate dev --name "describe-the-change"
// AuditLog is append-only — no UPDATE or DELETE ever permitted.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AuthProvider {
  LOCAL
  AZURE_AD
  GOOGLE
}

enum StorageProvider {
  S3
  MINIO
  LOCAL_FILESYSTEM
}

enum AiProvider {
  ANTHROPIC
  AZURE_OPENAI
  OPENAI
  OLLAMA
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
  OFFBOARDING
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
}

enum WorkflowStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  WITHDRAWN
  CANCELLED
}

enum WorkflowObjectType {
  DOCUMENT_REQUEST
  DOCUMENT
  CHANGE_REQUEST
  INCIDENT
  AUDIT
  CORRECTIVE_ACTION
  MEETING
  COMMITTEE
}

enum WorkflowApprovalMode {
  SINGLE
  SEQUENTIAL
  PARALLEL
  COMMITTEE
}

enum WorkflowParallelThreshold {
  ALL
  MAJORITY
  ANY
}

enum WorkflowAssigneeStrategy {
  SPECIFIC_USER
  ROLE
  ORG_UNIT_HEAD
  SELF
  COMMITTEE
  ROUND_ROBIN
  // ACC-54 — resolves to whoever holds a specific OrgPosition in a
  // specific, explicitly-configured OrgUnit. Named FIXED to pair with a
  // future POSITION_RELATIVE (same position, unit derived at trigger time
  // from the triggering object's own orgUnitId) — deferred until a
  // workflow-driven object actually carries an orgUnitId to derive from.
  POSITION_FIXED
}

enum WorkflowTriggerCondition {
  SPECIFIC_USER
  ROLE_BASED
  ANY_AUTHENTICATED
  SYSTEM_AUTOMATIC
  ASSIGNEE_POOL
}

enum WorkflowActionType {
  CREATE_TASK
  SEND_NOTIFICATION
  GENERATE_PDF
  LOCK_DOCUMENT
  LOG_AUDIT
  WEBHOOK
}

enum WorkflowApprovalDecision {
  PENDING
  APPROVED
  APPROVED_WITH_COMMENTS
  RETURNED
  ABSTAINED
}

enum WorkflowActionLogStatus {
  SUCCESS
  SUCCESS_UNASSIGNED
  FAILED
  RETRYING
}

enum WorkflowInstanceStageOutcome {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

// ACC-40 Section 2.6.3 — one unified shape for both delegation reasons this
// document defines, not two separate ad hoc fields. Neither
// WorkflowInstanceStage/WorkflowApproval/TaskAssignee previously recorded
// *why* an actor was eligible, only *who* acted.
enum DelegationReason {
  ACTING_HEAD // eligibility came from OrgUnit.actingHeadUserId, not real position-holding
  OUT_OF_OFFICE_COVERAGE // eligibility came from substituting in for an absent user via User.actingUserId
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
  DELEGATED
  UNASSIGNED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskSourceType {
  MEETING
  DOCUMENT
  AUDIT
  CAPA
  INCIDENT
  CORRECTIVE_ACTION
  STANDARD
  KPI
  GAP
  QUALITY_IMPROVEMENT_PLAN
  COMMITTEE
}

enum TaskEvidenceType {
  TEXT
  ATTACHMENT
  LINK
  INTERNAL_REFERENCE
}

enum TaskEvidenceRefType {
  DOCUMENT
  AUDIT
  INCIDENT
  CAPA
  MEETING
  STANDARD
  CORRECTIVE_ACTION
  GAP
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BOTH
  SMS
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
}

// ACC-82 — Setup health. The four condition types that ship (SYSTEM-REFERENCE
// §13.2). Two are deliberately absent — recorded deferrals, not missing values:
// "lookup value in use but deactivated" and stale invitations.
//
// ACC-120 slice 2 adds ACTING_HEAD_OPEN_ENDED. THIS MIGRATION DELIBERATELY DOES
// NOT REGISTER ITS DETECTOR, and the separation is the point: adding the value
// is safe for the container already running, but WRITING it is not. Until the
// old container is gone, it reads SetupCondition with a Prisma client whose
// enum lacks this variant and would throw on the unknown value. So the value
// ships and deploys first, alone; the detector that writes it follows in its
// own PR. Expand, then write — see CLAUDE.md, Key Architecture Decisions
// (ACC-127).
enum SetupConditionType {
  ORG_UNIT_WITHOUT_HEAD
  STAGE_WITHOUT_ASSIGNEE
  TASK_WITHOUT_OWNER
  POSITION_WITHOUT_ROLE
  ACTING_HEAD_OPEN_ENDED
}

// No HYGIENE tier yet: the only hygiene condition (stale invitations) was
// excluded, and a tier with no members — plus the snooze machinery that exists
// only for it — would be decorative. Both return with the first real one.
enum SetupConditionSeverity {
  BLOCKS_WORK
  AT_RISK
}

enum LookupLayer {
  SYSTEM
  TENANT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  SUBMIT
  APPROVE
  REJECT
  PUBLISH
  ARCHIVE
  RESTORE
  DELEGATE
  IMPERSONATE_START
  IMPERSONATE_END
}

enum PlanModuleAccess {
  FULL
  READ_ONLY
  NONE
}

// ---------------------------------------------------------------------------
// Organization (Tenant)
// ---------------------------------------------------------------------------

model Organization {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  country          String
  timezone         String           @default("Asia/Riyadh")
  language         String           @default("en")
  authProvider     AuthProvider     @default(LOCAL)
  storageProvider  StorageProvider  @default(S3)
  aiProvider       AiProvider       @default(ANTHROPIC)
  plan             SubscriptionPlan @default(STARTER)
  status           TenantStatus     @default(TRIAL)
  trialEndsAt      DateTime?
  stripeCustomerId String?
  maxUsers         Int              @default(25)
  maxStorageGb     Int              @default(10)

  // Encrypted provider config (JSON blob, encrypted at rest)
  authConfig    String?
  storageConfig String?
  aiConfig      String?
  emailConfig   String? // ADD (ACC-13) — same encrypted-JSON pattern, UI only for now (see CLAUDE.md's Email Provider section)

  // Bootstrap lifecycle — prevents double-provisioning of system defaults
  isBootstrapped Boolean   @default(false)
  bootstrappedAt DateTime?

  // Tenant-configurable settings blob — not encrypted (no secrets), e.g.
  // { taskSla: { CRITICAL, HIGH, MEDIUM, LOW } } (hours). Falls back to
  // code-level platform defaults when absent.
  settings Json?

  // ACC-13 additions
  logo          String? // S3 key — resolved to a signed URL at read time, never a direct path
  isPlatformOrg Boolean @default(false) // exactly one Organization row is ever true — see PlatformGuard
  planId        String? // FK to the new DB-driven Plan catalog — nullable: pre-ACC-13 tenants have none yet
  planCatalog   Plan?   @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  roles                  Role[]
  lookupValues           LookupValue[]
  lookupCategories       LookupCategory[]
  workflowTemplates      WorkflowTemplate[]
  workflowInstances      WorkflowInstance[]
  workflowActionLogs     WorkflowActionLog[]
  workingCalendar        WorkingCalendar?
  orgUnits               OrgUnit[]
  orgPositions           OrgPosition[]
  tasks                  Task[]
  taskEvidence           TaskEvidence[]
  notifications          Notification[]
  setupConditions        SetupCondition[]
  setupConditionRuns     SetupConditionRun[]
  committees             Committee[]
  meetings               Meeting[]
  auditLogs              AuditLog[]
  aiInteractionLogs      AiInteractionLog[]
  loginAttempts          LoginAttempt[]
  refreshTokens          RefreshToken[]
  userTransferEvents     UserTransferEvent[] // ACC-46 Section 2.6.f
  orgUnitHeadAssignments OrgUnitHeadAssignment[]

  @@index([slug])
  @@index([status])
  @@index([isPlatformOrg])
  @@index([planId])
}

// ---------------------------------------------------------------------------
// Plan Catalog (ACC-13) — global, tenant-independent. None of these four
// models carry an organizationId by design (CLAUDE.md: "Plans are stored in
// DB — never hardcoded", managed entirely by Platform Admin via PlatformGuard).
// ---------------------------------------------------------------------------

model Plan {
  id                String   @id @default(cuid())
  name              String
  nameEn            String
  nameAr            String
  monthlyPrice      Decimal  @db.Decimal(10, 2)
  annualPrice       Decimal  @db.Decimal(10, 2)
  maxFullUsers      Int? // null = unlimited (Enterprise)
  maxStaff          Int? // null = unlimited
  maxStorageGb      Int
  aiCreditsPerMonth Int
  isActive          Boolean  @default(true)
  isPublic          Boolean  @default(true) // false = custom/negotiated, hidden from self-service pricing
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  planModules   PlanModule[]
  organizations Organization[]

  @@index([isActive])
  @@index([isPublic])
}

model PlanModule {
  id          String           @id @default(cuid())
  planId      String
  moduleKey   String // free text by convention (e.g. "documents", "audit") — never a Prisma enum
  accessLevel PlanModuleAccess @default(NONE)

  plan Plan @relation(fields: [planId], references: [id])

  @@unique([planId, moduleKey])
  @@index([planId])
}

model AiCreditPack {
  id          String   @id @default(cuid())
  name        String
  nameAr      String?
  credits     Int
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  availableTo String[] // Plan.id[] this pack can be purchased under; empty = all plans
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model AiFeatureCost {
  id          String   @id @default(cuid())
  featureKey  String   @unique
  creditCost  Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id               String     @id @default(cuid())
  organizationId   String
  email            String
  name             String
  avatarUrl        String?
  status           UserStatus @default(INVITED)
  tokenVersion     Int        @default(0)
  language         String?
  hijriDisplay     Boolean    @default(false)
  tosAcceptedAt    DateTime?
  tosVersion       String?
  lastLoginAt      DateTime?
  lastLoginIp      String?
  positionId       String?
  primaryOrgUnitId String?
  outOfOfficeFrom  DateTime?
  outOfOfficeTo    DateTime?
  actingUserId     String?

  // ACC-40 Section 2.7 — a recovered, seven-month-old dropped business rule
  // (step-02-organization-structure.md Section 11). Pure scoping, confers
  // no authority — fully independent of positionId/primaryOrgUnitId-driven
  // Head derivation (2.1/2.2/2.5) and of OrgUnit.actingHeadUserId (2.6),
  // by deliberate design, not oversight. See 2.7's own "THE KEY QUESTION".
  actingOrgUnitId    String?
  actingOrgUnitUntil DateTime?

  // Step 9 additions — see backend/Plans/step-09-user-management.md Section 2
  authUserId          String?   @unique // link to Better Auth's own identity row (AuthUser)
  managerId           String?
  invitationToken     String?   @unique
  invitationExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization                    Organization               @relation(fields: [organizationId], references: [id])
  userRoles                       UserRole[]
  workflowApprovals               WorkflowApproval[]
  tasksCreated                    Task[]                     @relation("TaskCreator")
  taskAssignments                 TaskAssignee[]             @relation("TaskAssigneeUser")
  taskAssignmentsMade             TaskAssignee[]             @relation("TaskAssigneeAssignedBy")
  taskEvidenceUploaded            TaskEvidence[]
  notifications                   Notification[]
  committeeMembers                CommitteeMember[]
  committeeMembershipEvents       CommitteeMembershipEvent[]
  meetings                        Meeting[]                  @relation("MeetingOrganizer")
  auditLogs                       AuditLog[]
  aiInteractionLogs               AiInteractionLog[]
  position                        OrgPosition?               @relation(fields: [positionId], references: [id])
  primaryOrgUnit                  OrgUnit?                   @relation(fields: [primaryOrgUnitId], references: [id])
  actingOrgUnit                   OrgUnit?                   @relation("UserActingOrgUnit", fields: [actingOrgUnitId], references: [id])
  actingUser                      User?                      @relation("UserActingUser", fields: [actingUserId], references: [id])
  actingForUsers                  User[]                     @relation("UserActingUser")
  authUser                        AuthUser?                  @relation(fields: [authUserId], references: [id])
  manager                         User?                      @relation("UserManager", fields: [managerId], references: [id])
  directReports                   User[]                     @relation("UserManager")
  refreshTokens                   RefreshToken[]
  // ACC-40 Section 2.3 — back-relations for OrgUnit.pendingHeadUserId/
  // actingHeadUserId and OrgUnitHeadEvent.userId.
  pendingHeadForOrgUnits          OrgUnit[]                  @relation("OrgUnitPendingHead")
  actingHeadForOrgUnits           OrgUnit[]                  @relation("OrgUnitActingHead")
  orgUnitHeadEvents               OrgUnitHeadEvent[]         @relation("OrgUnitHeadEventUser")
  // ACC-120 slice 2 — three distinct roles on one assignment row.
  headAssignments                 OrgUnitHeadAssignment[]    @relation("OrgUnitHeadAssignmentUser")
  headAssignmentsCreated          OrgUnitHeadAssignment[]    @relation("OrgUnitHeadAssignmentCreatedBy")
  headAssignmentsEnded            OrgUnitHeadAssignment[]    @relation("OrgUnitHeadAssignmentEndedBy")
  // ACC-46 Section 2.6.f — back-relations for UserTransferEvent's three
  // distinct User FKs (the transferred person, an optional succession
  // replacement, an optional new manager — all on the same model, so each
  // needs its own named relation).
  userTransferEventsAsUser        UserTransferEvent[]        @relation("UserTransferEventUser")
  userTransferEventsAsReplacement UserTransferEvent[]        @relation("UserTransferEventReplacement")
  userTransferEventsAsNewManager  UserTransferEvent[]        @relation("UserTransferEventNewManager")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@index([actingUserId])
  @@index([status])
  @@index([positionId])
  @@index([primaryOrgUnitId])
  @@index([actingOrgUnitId])
  @@index([managerId])
  @@index([invitationToken])
}

// ---------------------------------------------------------------------------
// Roles and Permissions
// ---------------------------------------------------------------------------

model Role {
  id             String   @id @default(cuid())
  organizationId String
  key            String?
  nameEn         String
  nameAr         String
  description    String?
  isSystem       Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization     @relation(fields: [organizationId], references: [id])
  userRoles           UserRole[]
  rolePermissions     RolePermission[]
  reportingCommittees Committee[] // back-relation for Committee.reportingToRoleId (ACC-22)
  mappedPositions     OrgPosition[] // back-relation for OrgPosition.roleId (ACC-40 Section 2.9)

  @@unique([organizationId, key])
  @@unique([organizationId, nameEn])
  @@index([organizationId])
}

model Permission {
  id          String  @id @default(cuid())
  module      String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@index([module])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  // ACC-40 Section 2.6.5 — set only when this row was created by
  // head-authority coverage (real position-holding or Acting Head), not an
  // ordinary role assignment. Holds the OrgUnit id the authority is scoped
  // to — the revoke key for every unit-scoped grant (real position-holding
  // in a unit, and Acting Head, which is always unit-scoped by
  // construction). Null for org-wide (primaryOrgUnitId: null) real
  // position-holding grants, where grantedViaHeadPositionId below is the
  // revoke key instead — never both null, never both set, on a marked row.
  grantedViaHeadPositionOrgUnitId String?

  // ACC-40 Section 2.6.5 (revised) — the OrgPosition id this grant derives
  // from. Always populated on a marked row for audit value, but only ever
  // used as the REVOKE key when grantedViaHeadPositionOrgUnitId above is
  // null (the org-wide case) — a positionId is never null for a real
  // grant, so it's unambiguous where the OrgUnit id can't safely be used
  // (Prisma's equals:null would also match ordinary, independently-held
  // rows in a deleteMany where-clause).
  grantedViaHeadPositionId String?

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Lookup System
// ---------------------------------------------------------------------------

model LookupCategory {
  id              String   @id @default(cuid())
  organizationId  String?
  key             String
  labelEn         String
  labelAr         String
  isSystem        Boolean  @default(false)
  isExtensible    Boolean  @default(true)
  attributeSchema Json?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  values       LookupValue[]

  @@unique([key, organizationId])
  @@index([organizationId])
}

model LookupValue {
  id              String      @id @default(cuid())
  organizationId  String?
  categoryId      String
  key             String
  labelEn         String
  labelAr         String
  layer           LookupLayer @default(SYSTEM)
  attributes      Json?
  isActive        Boolean     @default(true)
  isHidden        Boolean     @default(false)
  labelOverrideEn String?
  labelOverrideAr String?
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization Organization?  @relation(fields: [organizationId], references: [id])
  category     LookupCategory @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, key, organizationId])
  @@index([organizationId])
  @@index([categoryId])
  @@index([layer])
}

// ---------------------------------------------------------------------------
// Working Calendar
// ---------------------------------------------------------------------------

model WorkingCalendar {
  id                String   @id @default(cuid())
  organizationId    String   @unique
  timezone          String   @default("Asia/Riyadh")
  workingDays       Int[]
  workingHoursStart String   @default("08:00")
  workingHoursEnd   String   @default("16:00")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  publicHolidays PublicHoliday[]
}

model PublicHoliday {
  id                String   @id @default(cuid())
  workingCalendarId String
  nameEn            String
  nameAr            String?
  date              DateTime
  isRecurring       Boolean  @default(false)
  createdAt         DateTime @default(now())

  workingCalendar WorkingCalendar @relation(fields: [workingCalendarId], references: [id])

  @@index([workingCalendarId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Organization Units
// ---------------------------------------------------------------------------

model OrgUnit {
  id             String   @id @default(cuid())
  organizationId String
  parentId       String?
  nameEn         String
  nameAr         String?
  code           String
  type           String?
  description    String?
  isActive       Boolean  @default(true)
  isCodeLocked   Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ACC-40 Section 2.3 — cache fields for the currently-open handover (if
  // any). NOT the source of truth (the actual state is two real
  // User.positionId assignments) — a cheap read for "is a handover in
  // progress here" without re-deriving it from a position count each time.
  pendingHeadUserId                 String?
  headHandoverEffectiveDate         DateTime?
  // ACC-40 Section 2.5 — cache of a position-holding query.
  isHeadVacant                      Boolean   @default(false)
  headVacantSince                   DateTime?
  // ACC-40 Section 2.5.1 — isHeadVacant alone cannot serve as the
  // sweepOrgUnitVacancies() wasFullyExhausted/isNowFullyExhausted
  // comparison target (it captures only this unit's own vacancy, not
  // whether ancestor escalation currently covers it) — mirrors
  // WorkflowInstanceStage.isUnassigned's exact role, one level deeper.
  // headFullyUnresolvedLastRemindedAt: set on every notification (first +
  // every 2-day reminder), cleared entirely on recovery, never left stale.
  isHeadFullyUnresolved             Boolean   @default(false)
  headFullyUnresolvedLastRemindedAt DateTime?
  // ACC-40 Section 2.6 — independent of position-holding entirely.
  //
  // ACC-120 slice 2 — KEPT FOR COMPATIBILITY, NOT AS A DESIGN CHOICE, AND
  // DROPPED IN THE CONTRACT STEP. OrgUnitHeadAssignment is the truth now.
  // Anything new reads that table; this column exists only so the container
  // already running keeps working across the deploy, and so existing callers
  // are migrated deliberately rather than in one sweep.
  //
  // Its recomputer is SlaMonitorProcessor's sweep (ACC-82's rule: a cached
  // flag names its recomputer in the same change). AND THE HONEST CAVEAT,
  // written down rather than left implied: the sweep is a scheduled job, and
  // per ACC-93 nothing reports a scheduled job that fails to run. So this
  // cache can go stale silently — in exactly the case it exists for, an
  // appointment that expires by DATE with nobody pressing anything. That is
  // a reason to finish the contract step, not a reason to trust the column.
  actingHeadUserId                  String?

  organization                    Organization            @relation(fields: [organizationId], references: [id])
  parent                          OrgUnit?                @relation("OrgUnitHierarchy", fields: [parentId], references: [id])
  children                        OrgUnit[]               @relation("OrgUnitHierarchy")
  users                           User[]
  actingUsers                     User[]                  @relation("UserActingOrgUnit") // back-relation for User.actingOrgUnitId (ACC-40 Section 2.7)
  // ACC-54 — back-relation for WorkflowStage.assigneeOrgUnitId (POSITION_FIXED).
  assigneeForWorkflowStages       WorkflowStage[]         @relation("WorkflowStageAssigneeOrgUnit")
  pendingHead                     User?                   @relation("OrgUnitPendingHead", fields: [pendingHeadUserId], references: [id])
  actingHead                      User?                   @relation("OrgUnitActingHead", fields: [actingHeadUserId], references: [id])
  headEvents                      OrgUnitHeadEvent[]
  // ACC-46 Section 2.6.f — back-relations for UserTransferEvent's two
  // distinct OrgUnit FKs (source and destination of a transfer).
  userTransferEventsAsSource      UserTransferEvent[]     @relation("UserTransferEventSourceUnit")
  userTransferEventsAsDestination UserTransferEvent[]     @relation("UserTransferEventDestinationUnit")
  headAssignments                 OrgUnitHeadAssignment[] // ACC-120 slice 2

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentId])
  @@index([pendingHeadUserId])
  @@index([actingHeadUserId])
}

// ACC-40 Section 2.3 — deliberately modeled after CommitteeMembershipEvent's
// exact shape: action enum, effectiveDate distinct from createdAt,
// reason/approvedBy both nullable. Same precedent, same reasoning: an
// append-only ledger answering "who held this authority, when, and why."
model OrgUnitHeadEvent {
  id             String            @id @default(cuid())
  organizationId String // denormalized from OrgUnit.organizationId, set once at creation
  orgUnitId      String
  userId         String // the person the event is about
  positionId     String? // the specific isUnitHeadPosition position involved; null only for ACTING_* events
  action         OrgUnitHeadAction
  effectiveDate  DateTime
  reason         String?
  approvedBy     String? // userId — nullable, not every event needs approval
  createdAt      DateTime          @default(now())

  orgUnit  OrgUnit      @relation(fields: [orgUnitId], references: [id])
  user     User         @relation("OrgUnitHeadEventUser", fields: [userId], references: [id])
  position OrgPosition? @relation(fields: [positionId], references: [id])

  @@index([organizationId])
  @@index([orgUnitId])
  @@index([userId])
}

// ACC-120 slice 2 — WHO HELD A UNIT'S HEADSHIP, OVER WHAT PERIOD.
//
// A PERIOD TABLE, not an event log, and the difference is the reason it
// exists. OrgUnitHeadEvent records that something HAPPENED, stamped with
// `new Date()` at the moment of the API call. That was sufficient while an
// acting appointment had no dates of its own: the button-press time WAS the
// real time, and ACTING_ASSIGNED paired with the next ACTING_ENDED.
//
// It stops being sufficient the moment an appointment carries its own dates.
// A period may start in the future, and — decisively — AN APPOINTMENT WITH AN
// END DATE ENDS BY TIME, WITH NOBODY PRESSING ANYTHING, so no ACTING_ENDED
// event is ever written. Without this table the previous period's real dates
// would be overwritten by the next appointment and no other copy would exist:
// "who was acting head of Pharmacy last March" becomes permanently
// unanswerable, and an accreditation surveyor asks exactly that.
//
// OrgUnitHeadEvent is NOT replaced. It keeps recording handover mechanics
// (declared, completed, cancelled, vacated) which are events, not periods.
model OrgUnitHeadAssignment {
  id             String @id @default(cuid())
  organizationId String // denormalized from OrgUnit.organizationId, set once at creation
  orgUnitId      String
  userId         String

  // KIND IS PRESENT FROM DAY ONE BECAUSE ADDING IT LATER COSTS A MIGRATION —
  // not because substantive headship moves here soon. It does not: substantive
  // headship is still derived from position-holding (User.position.
  // isUnitHeadPosition + primaryOrgUnitId) and restructuring that competes with
  // OrgPosition and belongs in its own ticket. One enum with one value unused
  // for now is the cheapest this decision will ever be.
  kind OrgUnitHeadAssignmentKind

  // Acting only; null for SUBSTANTIVE. Distinguishes covering a post whose
  // holder has LEFT from covering one whose holder is in post but away beyond
  // what out-of-office may carry (capped at 60 days).
  //
  // NEITHER REASON AUTO-ENDS, and that is written here so nobody infers
  // automation that does not exist. An ABSENCE appointment SHOULD end when the
  // head returns and nothing makes it. A VACANCY one should end when a head is
  // appointed and nothing makes that either. The 90-day
  // ACTING_HEAD_OPEN_ENDED condition is a LATE BACKSTOP that reports the
  // situation to a human — it is not the mechanism, and must not be mistaken
  // for one.
  reason OrgUnitActingReason?

  // The head-conferring position, when one is involved. Null for acting, per
  // OrgUnitHeadEvent's own 2.3 convention: acting authority never derives from
  // position-holding.
  positionId String?

  validFrom DateTime
  // NULL IS MEANINGFUL: "until it is ended by hand". This is the state the
  // 90-day condition reports, so it stays nullable permanently — it is not a
  // column awaiting a contract step.
  validTo   DateTime?

  endedAt     DateTime? // set when a period is ended EARLY, distinct from validTo lapsing
  endedById   String?
  endedReason String?

  createdAt   DateTime @default(now())
  createdById String

  organization Organization @relation(fields: [organizationId], references: [id])
  orgUnit      OrgUnit      @relation(fields: [orgUnitId], references: [id])
  user         User         @relation("OrgUnitHeadAssignmentUser", fields: [userId], references: [id])
  endedBy      User?        @relation("OrgUnitHeadAssignmentEndedBy", fields: [endedById], references: [id])
  createdBy    User         @relation("OrgUnitHeadAssignmentCreatedBy", fields: [createdById], references: [id])
  position     OrgPosition? @relation(fields: [positionId], references: [id])

  @@index([organizationId])
  @@index([orgUnitId])
  @@index([userId])
  // "who held this unit's headship on date X" — the surveyor's question.
  @@index([orgUnitId, kind, validFrom])
}

enum OrgUnitHeadAssignmentKind {
  SUBSTANTIVE // unused until substantive headship moves here; see the model comment
  ACTING
}

enum OrgUnitActingReason {
  VACANCY // the holder has left; no substantive head exists
  ABSENCE // the head is in post but unavailable beyond out-of-office's 60-day cap
}

enum OrgUnitHeadAction {
  ASSIGNED // direct appointment to a head-conferring position, no handover — e.g. filling a vacancy
  HANDOVER_DECLARED // incoming successor granted the same position, outgoing holder unchanged
  HANDOVER_COMPLETED // outgoing holder's position cleared, incoming successor now sole holder
  HANDOVER_CANCELLED // incoming successor's position grant reverted, outgoing holder unaffected
  VACATED // head-conferring position cleared with no successor declared
  ACTING_ASSIGNED // 2.6 — does not touch position-holding
  ACTING_ENDED // 2.6 — does not touch position-holding
}

// ACC-46 Section 2.6.f — a transfer (unit + position + manager changing
// together, sometimes a promotion) is a distinct business event deserving
// its own queryable history — not scattered across generic AuditLog rows or
// folded into OrgUnitHeadEvent's narrower purpose. Coexists with, doesn't
// replace, the mandatory AuditLogService.log() call and, for a promotion,
// assignHead()'s own OrgUnitHeadEvent write — all three fire for a
// promotion-variant transfer, each capturing a different, valid angle.
//
// Write timing (2.6.c): for a non-promotion transfer, written inside the
// same transaction as the rest of the transfer. For a promotion, written
// only after the assignHead() attempt has resolved (success or failure) —
// isPromotion records CONFIRMED outcome, never intent, so a failed
// promotion attempt never leaves a factually wrong row behind.
model UserTransferEvent {
  id                    String   @id @default(cuid())
  organizationId        String // denormalized, same precedent as OrgUnitHeadEvent
  userId                String // the transferred person
  sourceOrgUnitId       String
  destinationOrgUnitId  String
  sourcePositionId      String? // not a relation — informational only, matches OrgUnitHeadEvent.positionId's own optionality
  destinationPositionId String?
  replacementUserId     String? // set only for a succession (Case B) transfer
  newManagerId          String? // null for the root-promotion exemption
  // CONFIRMED outcome — true only once assignHead() has actually succeeded,
  // never written optimistically. promotionAttempted distinguishes
  // "attempted, failed" from "never a promotion" in query results.
  isPromotion           Boolean  @default(false)
  promotionAttempted    Boolean  @default(false)
  effectiveDate         DateTime @default(now())
  // actorId — always required (a transfer always has an acting admin).
  // Deliberately NOT named approvedBy (unlike OrgUnitHeadEvent.approvedBy,
  // nullable there) — this redesign never included a formal approval/
  // review step; a transfer is a direct, single-actor action performed by
  // a Tenant Admin, so this records who executed it, not who approved it.
  performedBy           String
  createdAt             DateTime @default(now())

  organization       Organization @relation(fields: [organizationId], references: [id])
  user               User         @relation("UserTransferEventUser", fields: [userId], references: [id])
  replacement        User?        @relation("UserTransferEventReplacement", fields: [replacementUserId], references: [id])
  newManager         User?        @relation("UserTransferEventNewManager", fields: [newManagerId], references: [id])
  sourceOrgUnit      OrgUnit      @relation("UserTransferEventSourceUnit", fields: [sourceOrgUnitId], references: [id])
  destinationOrgUnit OrgUnit      @relation("UserTransferEventDestinationUnit", fields: [destinationOrgUnitId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([sourceOrgUnitId])
  @@index([destinationOrgUnitId])
}

// ACC-40 — org-wide catalog (no longer per-OrgUnit): a position title like
// "Department Manager" is one defined catalog entry, not a per-unit clone.
// Whether it may be held simultaneously by more than one person, and
// whether holding it confers Head authority, are both now expressed by
// isSingleAssignee/isUnitHeadPosition rather than by orgUnitId scoping —
// see backend/Plans/step-40-org-position-unit-head.md Section 2.1.
model OrgPosition {
  id                 String   @id @default(cuid())
  organizationId     String
  nameEn             String
  nameAr             String?
  grade              Int
  isSingleAssignee   Boolean  @default(false)
  isUnitHeadPosition Boolean  @default(false)
  roleId             String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization    Organization            @relation(fields: [organizationId], references: [id])
  role            Role?                   @relation(fields: [roleId], references: [id])
  users           User[]
  headEvents      OrgUnitHeadEvent[] // back-relation for OrgUnitHeadEvent.positionId (ACC-40 Section 2.3)
  headAssignments OrgUnitHeadAssignment[] // ACC-120 slice 2
  // ACC-54 — back-relation for WorkflowStage.assigneePositionId (POSITION_FIXED).
  workflowStages  WorkflowStage[]

  @@unique([organizationId, nameEn])
  @@index([organizationId])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Workflow Engine
// ---------------------------------------------------------------------------

model WorkflowTemplate {
  id             String             @id @default(cuid())
  organizationId String
  nameEn         String
  nameAr         String
  objectType     WorkflowObjectType
  isDefault      Boolean            @default(false)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  stages       WorkflowStage[]
  instances    WorkflowInstance[]

  @@index([organizationId])
  @@index([objectType])
}

model WorkflowStage {
  id                 String  @id @default(cuid())
  workflowTemplateId String
  nameEn             String
  nameAr             String
  description        String?
  order              Int
  slaWorkingHours    Int?
  isInitial          Boolean @default(false)
  isFinal            Boolean @default(false)

  approvalMode      WorkflowApprovalMode       @default(SINGLE)
  parallelThreshold WorkflowParallelThreshold?
  committeeId       String?

  assigneeStrategy             WorkflowAssigneeStrategy @default(ROLE)
  assigneeUserId               String?
  assigneeRoleId               String?
  // Only meaningful when assigneeStrategy = COMMITTEE (ACC-28). Narrows
  // resolveAssigneeRaw()'s COMMITTEE case to members whose roleValueId
  // matches this lookup value (e.g. "chairman"). Null = every active
  // member, i.e. the pre-ACC-28 behavior — backward compatible with
  // every existing seeded stage.
  assigneeCommitteeRoleValueId String?

  // ACC-54 — only meaningful when assigneeStrategy = POSITION_FIXED, and
  // named for that strategy rather than abstractly, following the exact
  // precedent assigneeCommitteeRoleValueId above set (ACC-28): a field that
  // only means something for one strategy is clearer named after it than
  // given a fake-generic name. assigneePositionId is expected to be reused
  // unchanged by a future POSITION_RELATIVE; assigneeOrgUnitId is
  // FIXED-only by construction, since RELATIVE derives the unit at trigger
  // time instead of storing one.
  //
  // Deliberately no @@index on either: WorkflowStage is only ever loaded by
  // its own id or by workflowTemplateId, never queried BY assignee — the
  // same reason the existing assigneeRoleId/assigneeUserId/committeeId
  // columns carry no index.
  //
  // Cross-tenant integrity is enforced at the service layer on write, not
  // by the FK (OrgPosition/OrgUnit are tenant-scoped but WorkflowStage
  // reaches its tenant only through WorkflowTemplate) — same shape as
  // ACC-17's assigneeUserId validation and ACC-28's validateCommitteeId().
  assigneePositionId String?
  assigneeOrgUnitId  String?

  escalationConfig Json?

  workflowTemplate WorkflowTemplate        @relation(fields: [workflowTemplateId], references: [id])
  transitionsFrom  WorkflowTransition[]    @relation("TransitionFrom")
  transitionsTo    WorkflowTransition[]    @relation("TransitionTo")
  instanceStages   WorkflowInstanceStage[]
  assigneePosition OrgPosition?            @relation(fields: [assigneePositionId], references: [id])
  assigneeOrgUnit  OrgUnit?                @relation("WorkflowStageAssigneeOrgUnit", fields: [assigneeOrgUnitId], references: [id])

  @@index([workflowTemplateId])
}

model WorkflowTransition {
  id                 String                   @id @default(cuid())
  fromStageId        String
  toStageId          String
  labelEn            String
  labelAr            String
  requiredPermission String?
  triggerCondition   WorkflowTriggerCondition @default(ROLE_BASED)
  triggerUserId      String?
  triggerRoleId      String?
  validatorConfig    Json?
  isApprovalPath     Boolean                  @default(false)

  fromStage WorkflowStage              @relation("TransitionFrom", fields: [fromStageId], references: [id])
  toStage   WorkflowStage              @relation("TransitionTo", fields: [toStageId], references: [id])
  actions   WorkflowTransitionAction[]

  @@index([fromStageId])
  @@index([toStageId])
}

model WorkflowInstance {
  id                 String             @id @default(cuid())
  organizationId     String
  workflowTemplateId String
  objectType         WorkflowObjectType
  objectId           String
  status             WorkflowStatus     @default(PENDING)
  currentStageId     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization     Organization            @relation(fields: [organizationId], references: [id])
  workflowTemplate WorkflowTemplate        @relation(fields: [workflowTemplateId], references: [id])
  stages           WorkflowInstanceStage[]
  tasks            Task[]
  actionLogs       WorkflowActionLog[]

  @@index([organizationId])
  @@index([workflowTemplateId])
  @@index([objectType, objectId])
  @@index([status])
}

model WorkflowInstanceStage {
  id                   String                       @id @default(cuid())
  workflowInstanceId   String
  stageId              String
  enteredAt            DateTime                     @default(now())
  exitedAt             DateTime?
  slaDueAt             DateTime?
  slaBreached          Boolean                      @default(false)
  escalatedRuleIndexes Int[]                        @default([])
  outcome              WorkflowInstanceStageOutcome @default(PENDING)
  actorId              String?
  comment              String?
  isUnassigned         Boolean                      @default(false)
  unassignedAt         DateTime?
  // ACC-40 Section 2.6.3 — why actorId was eligible, not just who acted.
  // Null for the ordinary case (actorId is a direct, undelegated
  // participant). delegationContextId: the OrgUnit id for ACTING_HEAD, the
  // covered-for user's id for OUT_OF_OFFICE_COVERAGE.
  delegationReason     DelegationReason?
  delegationContextId  String?

  workflowInstance WorkflowInstance   @relation(fields: [workflowInstanceId], references: [id])
  stage            WorkflowStage      @relation(fields: [stageId], references: [id])
  approvals        WorkflowApproval[]

  @@index([workflowInstanceId])
  @@index([stageId])
  @@index([slaDueAt])
}

model WorkflowApproval {
  id                      String                   @id @default(cuid())
  workflowInstanceStageId String
  approverId              String
  decision                WorkflowApprovalDecision @default(PENDING)
  comment                 String?
  decidedAt               DateTime?
  createdAt               DateTime                 @default(now())
  // ACC-40 Section 2.6.3 — same shape as WorkflowInstanceStage's own pair.
  delegationReason        DelegationReason?
  delegationContextId     String?

  workflowInstanceStage WorkflowInstanceStage @relation(fields: [workflowInstanceStageId], references: [id])
  approver              User                  @relation(fields: [approverId], references: [id])

  @@unique([workflowInstanceStageId, approverId])
  @@index([workflowInstanceStageId])
  @@index([approverId])
}

model WorkflowTransitionAction {
  id                   String             @id @default(cuid())
  workflowTransitionId String
  actionType           WorkflowActionType
  order                Int                @default(0)
  isEnabled            Boolean            @default(true)
  configJson           Json?

  workflowTransition WorkflowTransition  @relation(fields: [workflowTransitionId], references: [id])
  actionLogs         WorkflowActionLog[]

  @@index([workflowTransitionId])
}

model WorkflowActionLog {
  id                         String                  @id @default(cuid())
  organizationId             String
  workflowTransitionActionId String
  workflowInstanceId         String
  actionType                 WorkflowActionType
  status                     WorkflowActionLogStatus @default(SUCCESS)
  attemptCount               Int                     @default(1)
  responseSummary            String?
  errorMessage               String?
  executedAt                 DateTime                @default(now())

  organization             Organization             @relation(fields: [organizationId], references: [id])
  workflowTransitionAction WorkflowTransitionAction @relation(fields: [workflowTransitionActionId], references: [id])
  workflowInstance         WorkflowInstance         @relation(fields: [workflowInstanceId], references: [id])

  @@index([organizationId])
  @@index([workflowTransitionActionId])
  @@index([workflowInstanceId])
  @@index([status])
  @@index([executedAt])
}

// ---------------------------------------------------------------------------
// Task Management
// ---------------------------------------------------------------------------

model Task {
  id                 String         @id @default(cuid())
  organizationId     String
  title              String
  description        String?
  sourceType         TaskSourceType
  sourceId           String
  sourceStageId      String?
  workflowInstanceId String?
  meetingId          String?
  createdById        String
  status             TaskStatus     @default(PENDING)
  priority           TaskPriority   @default(MEDIUM)
  dueAt              DateTime?
  dueDateOverridden  Boolean        @default(false)
  slaBreachedAt      DateTime?
  completedAt        DateTime?
  completedById      String?
  // ACC-46 Section 2.7.b — escalationUserId/escalationAfterHours/escalatedAt
  // removed via real migration, not left as dead/repurposed columns
  // (ACC-44's own precedent for a confirmed-dead field): both were
  // @IsOptional() on CreateTaskDto with zero real callers ever setting
  // them (confirmed via full frontend grep), and even a hand-crafted API
  // call setting them correctly could never actually fire escalation —
  // SlaMonitorProcessor.sweepOverdueTasks()'s own query excluded status
  // OVERDUE, so a task was evaluated exactly once, before enough hours
  // could plausibly have elapsed, then permanently skipped forever after.
  // Replaced by two system-only timestamps, written only by
  // SlaMonitorProcessor, never by any caller — the "no human choice
  // anywhere" redesign (2.7.b/2.7.c) extends to the schema itself.
  managerEscalatedAt DateTime?
  headEscalatedAt    DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id])
  createdBy        User              @relation("TaskCreator", fields: [createdById], references: [id])
  workflowInstance WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id])
  assignees        TaskAssignee[]
  evidence         TaskEvidence[]

  @@index([organizationId])
  @@index([status])
  @@index([dueAt])
  @@index([sourceType, sourceId])
  @@index([meetingId])
}

model TaskAssignee {
  id                  String            @id @default(cuid())
  taskId              String
  userId              String
  assignedAt          DateTime          @default(now())
  assignedById        String
  removedAt           DateTime?
  // ACC-40 Section 2.6.3 — stamped once, at the moment this row is created,
  // by fireTransitionActions()'s CREATE_TASK handling — the exact moment
  // resolveAssignee() has full, fresh knowledge of why each resolved user
  // was included. Task.complete() needs no new fields — it reads this row
  // directly (userId === completedById), never re-derives.
  delegationReason    DelegationReason?
  delegationContextId String?

  task       Task @relation(fields: [taskId], references: [id])
  user       User @relation("TaskAssigneeUser", fields: [userId], references: [id])
  assignedBy User @relation("TaskAssigneeAssignedBy", fields: [assignedById], references: [id])

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model TaskEvidence {
  id             String               @id @default(cuid())
  organizationId String
  taskId         String
  type           TaskEvidenceType
  content        String?
  s3Key          String?
  fileName       String?
  fileSize       Int?
  mimeType       String?
  url            String?
  linkTitle      String?
  refType        TaskEvidenceRefType?
  refId          String?
  refDisplay     String?
  uploadedById   String
  uploadedAt     DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  task         Task         @relation(fields: [taskId], references: [id])
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  @@index([organizationId])
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  titleEn        String
  titleAr        String?
  bodyEn         String
  bodyAr         String?
  channel        NotificationChannel @default(IN_APP)
  status         NotificationStatus  @default(UNREAD)
  objectType     String?
  objectId       String?
  sentAt         DateTime?
  readAt         DateTime?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Setup Health (ACC-82) — SYSTEM-REFERENCE §13
// ---------------------------------------------------------------------------

// One row per EPISODE of a standing condition: opened, possibly re-severitied,
// cleared. A gap that closes and later reopens is a new row, so the seven-day
// closure history stays truthful.
//
// Written ONLY by the hourly reconciler. There is no read flag and no dismiss:
// a row is open because the condition is true, and clearedAt is set only when a
// reconciliation evaluates the condition and finds it gone — never by a person,
// and never because an evaluation failed.
//
// At most one OPEN row per (organizationId, type, objectId). Prisma cannot
// express a partial unique index without hand-editing the migration (forbidden),
// so the reconciler enforces it; the composite index below serves that lookup.
model SetupCondition {
  id             String                 @id @default(cuid())
  organizationId String
  type           SetupConditionType
  // Stored, not derived at read time, so a cleared row keeps the severity it had.
  severity       SetupConditionSeverity
  // The id the condition is about: OrgUnit, WorkflowStage, Task or OrgPosition,
  // per type. Not a foreign key — the object may be renamed or deleted while the
  // closure history must survive.
  objectId       String
  // Display snapshot refreshed on every pass while open (names, counts), so a
  // closed row still reads correctly after its object changes.
  subject        Json
  openedAt       DateTime
  lastSeenAt     DateTime
  clearedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, clearedAt])
  @@index([organizationId, type, objectId])
}

// When each (tenant, condition type) was last evaluated, and whether that
// evaluation succeeded. One row per pair, upserted by the reconciler on every
// attempt.
//
// Exists so the API can answer "when was this computed" per type, and say
// plainly when it cannot: a type whose last attempt failed, or whose last success
// is older than the reconciliation cadence allows, is reported as such rather
// than presenting its open rows as current. A single computed-at timestamp would
// hide exactly that case — a row stale because its sweep failed.
//
// lastError is for operators reading the database, never returned by the API:
// an exception message can carry internal detail.
model SetupConditionRun {
  id              String             @id @default(cuid())
  organizationId  String
  type            SetupConditionType
  lastAttemptedAt DateTime
  lastSucceededAt DateTime?
  lastFailedAt    DateTime?
  lastError       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, type])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Committee Management
// ---------------------------------------------------------------------------

model Committee {
  id                         String                    @id @default(cuid())
  organizationId             String
  nameEn                     String
  nameAr                     String
  typeValueId                String
  purpose                    String?
  quorumCount                Int                       @default(0)
  meetingFrequency           CommitteeMeetingFrequency @default(AS_NEEDED)
  parentCommitteeId          String?
  termsOfReferenceDocumentId String? // nullable, unpopulated until Document Management ships (ACC-22 Pending Discussion #1)
  reportingToCommitteeId     String? // mutually exclusive with reportingToRoleId, enforced at service layer
  reportingToRoleId          String? // mutually exclusive with reportingToCommitteeId, enforced at service layer
  formedAt                   DateTime?
  dissolvedAt                DateTime?
  isActive                   Boolean                   @default(true) // soft-deactivate flag, independent of workflow lifecycle stage
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  organization         Organization               @relation(fields: [organizationId], references: [id])
  parentCommittee      Committee?                 @relation("SubCommittees", fields: [parentCommitteeId], references: [id])
  subCommittees        Committee[]                @relation("SubCommittees")
  reportingToCommittee Committee?                 @relation("CommitteeReportingTo", fields: [reportingToCommitteeId], references: [id])
  reportsToMe          Committee[]                @relation("CommitteeReportingTo")
  reportingToRole      Role?                      @relation(fields: [reportingToRoleId], references: [id])
  members              CommitteeMember[]
  membershipEvents     CommitteeMembershipEvent[]
  meetings             Meeting[]

  @@index([organizationId])
  @@index([parentCommitteeId])
  @@index([reportingToCommitteeId])
  @@index([reportingToRoleId])
}

enum CommitteeMeetingFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  BIANNUAL
  ANNUAL
  AS_NEEDED
}

model CommitteeMember {
  id             String    @id @default(cuid())
  organizationId String // denormalized from Committee.organizationId, set once at creation, never updated
  committeeId    String
  userId         String
  roleValueId    String
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?
  isActive       Boolean   @default(true) // derived STRICTLY from leftAt at the service layer (isActive = leftAt === null)

  committee Committee @relation(fields: [committeeId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([committeeId, userId])
  @@index([organizationId])
  @@index([committeeId])
  @@index([userId])
}

model CommitteeMembershipEvent {
  id             String                    @id @default(cuid())
  organizationId String // denormalized from Committee.organizationId, set once at creation
  committeeId    String
  userId         String
  roleValueId    String
  action         CommitteeMembershipAction
  effectiveDate  DateTime
  reason         String?
  approvedBy     String? // userId — nullable, not every event needs approval
  createdAt      DateTime                  @default(now())

  committee Committee @relation(fields: [committeeId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([committeeId])
  @@index([userId])
}

enum CommitteeMembershipAction {
  JOINED
  LEFT
  ROLE_CHANGED
}

