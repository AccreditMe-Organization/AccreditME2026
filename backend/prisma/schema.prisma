// AccreditMe — Prisma Schema
// Single source of truth for the entire database.
// After ANY change: npx prisma migrate dev --name "describe-the-change"
// AuditLog is append-only — no UPDATE or DELETE ever permitted.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AuthProvider {
  LOCAL
  AZURE_AD
  GOOGLE
}

enum StorageProvider {
  S3
  MINIO
  LOCAL_FILESYSTEM
}

enum AiProvider {
  ANTHROPIC
  AZURE_OPENAI
  OPENAI
  OLLAMA
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
  OFFBOARDING
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
}

enum WorkflowStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  WITHDRAWN
  CANCELLED
}

enum WorkflowObjectType {
  DOCUMENT_REQUEST
  DOCUMENT
  CHANGE_REQUEST
  INCIDENT
  AUDIT
  CORRECTIVE_ACTION
  MEETING
  COMMITTEE
}

enum WorkflowApprovalMode {
  SINGLE
  SEQUENTIAL
  PARALLEL
  COMMITTEE
}

enum WorkflowParallelThreshold {
  ALL
  MAJORITY
  ANY
}

enum WorkflowAssigneeStrategy {
  SPECIFIC_USER
  ROLE
  ORG_UNIT_HEAD
  SELF
  COMMITTEE
  ROUND_ROBIN
}

enum WorkflowTriggerCondition {
  SPECIFIC_USER
  ROLE_BASED
  ANY_AUTHENTICATED
  SYSTEM_AUTOMATIC
}

enum WorkflowActionType {
  CREATE_TASK
  SEND_NOTIFICATION
  GENERATE_PDF
  LOCK_DOCUMENT
  LOG_AUDIT
  WEBHOOK
}

enum WorkflowApprovalDecision {
  PENDING
  APPROVED
  APPROVED_WITH_COMMENTS
  RETURNED
  ABSTAINED
}

enum WorkflowActionLogStatus {
  SUCCESS
  FAILED
  RETRYING
}

enum WorkflowInstanceStageOutcome {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
  DELEGATED
  UNASSIGNED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskSourceType {
  MEETING
  DOCUMENT
  AUDIT
  CAPA
  INCIDENT
  CORRECTIVE_ACTION
  STANDARD
  KPI
  GAP
  QUALITY_IMPROVEMENT_PLAN
}

enum TaskEvidenceType {
  TEXT
  ATTACHMENT
  LINK
  INTERNAL_REFERENCE
}

enum TaskEvidenceRefType {
  DOCUMENT
  AUDIT
  INCIDENT
  CAPA
  MEETING
  STANDARD
  CORRECTIVE_ACTION
  GAP
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BOTH
  SMS
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
}

enum LookupLayer {
  SYSTEM
  TENANT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  SUBMIT
  APPROVE
  REJECT
  PUBLISH
  ARCHIVE
  RESTORE
  DELEGATE
  IMPERSONATE_START
  IMPERSONATE_END
}

enum PlanModuleAccess {
  FULL
  READ_ONLY
  NONE
}

// ---------------------------------------------------------------------------
// Organization (Tenant)
// ---------------------------------------------------------------------------

model Organization {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  country          String
  timezone         String           @default("Asia/Riyadh")
  language         String           @default("en")
  authProvider     AuthProvider     @default(LOCAL)
  storageProvider  StorageProvider  @default(S3)
  aiProvider       AiProvider       @default(ANTHROPIC)
  plan             SubscriptionPlan @default(STARTER)
  status           TenantStatus     @default(TRIAL)
  trialEndsAt      DateTime?
  stripeCustomerId String?
  maxUsers         Int              @default(25)
  maxStorageGb     Int              @default(10)

  // Encrypted provider config (JSON blob, encrypted at rest)
  authConfig       String?
  storageConfig    String?
  aiConfig         String?
  emailConfig      String?          // ADD (ACC-13) — same encrypted-JSON pattern, UI only for now (see CLAUDE.md's Email Provider section)

  // Bootstrap lifecycle — prevents double-provisioning of system defaults
  isBootstrapped   Boolean          @default(false)
  bootstrappedAt   DateTime?

  // Tenant-configurable settings blob — not encrypted (no secrets), e.g.
  // { taskSla: { CRITICAL, HIGH, MEDIUM, LOW } } (hours). Falls back to
  // code-level platform defaults when absent.
  settings         Json?

  // ACC-13 additions
  logo             String?          // S3 key — resolved to a signed URL at read time, never a direct path
  isPlatformOrg    Boolean          @default(false)   // exactly one Organization row is ever true — see PlatformGuard
  planId           String?          // FK to the new DB-driven Plan catalog — nullable: pre-ACC-13 tenants have none yet
  planCatalog      Plan?            @relation(fields: [planId], references: [id])

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  users            User[]
  roles            Role[]
  lookupValues      LookupValue[]
  lookupCategories  LookupCategory[]
  workflowTemplates WorkflowTemplate[]
  workflowInstances  WorkflowInstance[]
  workflowActionLogs WorkflowActionLog[]
  workingCalendar  WorkingCalendar?
  orgUnits         OrgUnit[]
  orgPositions     OrgPosition[]
  tasks            Task[]
  taskEvidence     TaskEvidence[]
  notifications    Notification[]
  committees       Committee[]
  meetings         Meeting[]
  auditLogs        AuditLog[]
  aiInteractionLogs AiInteractionLog[]
  loginAttempts    LoginAttempt[]
  refreshTokens    RefreshToken[]

  @@index([slug])
  @@index([status])
  @@index([isPlatformOrg])
  @@index([planId])
}

// ---------------------------------------------------------------------------
// Plan Catalog (ACC-13) — global, tenant-independent. None of these four
// models carry an organizationId by design (CLAUDE.md: "Plans are stored in
// DB — never hardcoded", managed entirely by Platform Admin via PlatformGuard).
// ---------------------------------------------------------------------------

model Plan {
  id                String   @id @default(cuid())
  name              String
  nameEn            String
  nameAr            String
  monthlyPrice      Decimal  @db.Decimal(10, 2)
  annualPrice       Decimal  @db.Decimal(10, 2)
  maxFullUsers      Int?                            // null = unlimited (Enterprise)
  maxStaff          Int?                            // null = unlimited
  maxStorageGb      Int
  aiCreditsPerMonth Int
  isActive          Boolean  @default(true)
  isPublic          Boolean  @default(true)          // false = custom/negotiated, hidden from self-service pricing
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  planModules       PlanModule[]
  organizations     Organization[]

  @@index([isActive])
  @@index([isPublic])
}

model PlanModule {
  id          String           @id @default(cuid())
  planId      String
  moduleKey   String                                 // free text by convention (e.g. "documents", "audit") — never a Prisma enum
  accessLevel PlanModuleAccess @default(NONE)

  plan        Plan             @relation(fields: [planId], references: [id])

  @@unique([planId, moduleKey])
  @@index([planId])
}

model AiCreditPack {
  id        String   @id @default(cuid())
  name      String
  nameAr    String?
  credits   Int
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  availableTo String[]                                // Plan.id[] this pack can be purchased under; empty = all plans
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model AiFeatureCost {
  id          String   @id @default(cuid())
  featureKey  String   @unique
  creditCost  Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id               String       @id @default(cuid())
  organizationId   String
  email            String
  name             String
  avatarUrl        String?
  status           UserStatus   @default(INVITED)
  tokenVersion     Int          @default(0)
  language         String?
  hijriDisplay     Boolean      @default(false)
  tosAcceptedAt    DateTime?
  tosVersion       String?
  lastLoginAt      DateTime?
  lastLoginIp      String?
  positionId       String?
  primaryOrgUnitId String?
  outOfOfficeFrom  DateTime?
  outOfOfficeTo    DateTime?
  actingUserId     String?

  // Step 9 additions — see backend/Plans/step-09-user-management.md Section 2
  authUserId          String?   @unique   // link to Better Auth's own identity row (AuthUser)
  managerId           String?
  invitationToken     String?   @unique
  invitationExpiresAt DateTime?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id])
  userRoles        UserRole[]
  workflowApprovals WorkflowApproval[]
  tasksCreated     Task[]       @relation("TaskCreator")
  taskAssignments  TaskAssignee[] @relation("TaskAssigneeUser")
  taskAssignmentsMade TaskAssignee[] @relation("TaskAssigneeAssignedBy")
  taskEvidenceUploaded TaskEvidence[]
  notifications    Notification[]
  committeeMembers CommitteeMember[]
  meetings         Meeting[]    @relation("MeetingOrganizer")
  auditLogs        AuditLog[]
  aiInteractionLogs AiInteractionLog[]
  position         OrgPosition? @relation(fields: [positionId], references: [id])
  primaryOrgUnit   OrgUnit?     @relation(fields: [primaryOrgUnitId], references: [id])
  actingUser       User?        @relation("UserActingUser", fields: [actingUserId], references: [id])
  actingForUsers   User[]       @relation("UserActingUser")
  authUser         AuthUser?    @relation(fields: [authUserId], references: [id])
  manager          User?        @relation("UserManager", fields: [managerId], references: [id])
  directReports    User[]       @relation("UserManager")
  refreshTokens    RefreshToken[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@index([actingUserId])
  @@index([status])
  @@index([positionId])
  @@index([primaryOrgUnitId])
  @@index([managerId])
  @@index([invitationToken])
}

// ---------------------------------------------------------------------------
// Roles and Permissions
// ---------------------------------------------------------------------------

model Role {
  id             String       @id @default(cuid())
  organizationId String
  key            String?
  nameEn         String
  nameAr         String
  description    String?
  isSystem       Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  userRoles      UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, key])
  @@unique([organizationId, nameEn])
  @@index([organizationId])
}

model Permission {
  id          String           @id @default(cuid())
  module      String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@index([module])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Lookup System
// ---------------------------------------------------------------------------

model LookupCategory {
  id              String         @id @default(cuid())
  organizationId  String?
  key             String
  labelEn         String
  labelAr         String
  isSystem        Boolean        @default(false)
  isExtensible    Boolean        @default(true)
  attributeSchema Json?
  isActive        Boolean        @default(true)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization?  @relation(fields: [organizationId], references: [id])
  values          LookupValue[]

  @@unique([key, organizationId])
  @@index([organizationId])
}

model LookupValue {
  id              String         @id @default(cuid())
  organizationId  String?
  categoryId      String
  key             String
  labelEn         String
  labelAr         String
  layer           LookupLayer    @default(SYSTEM)
  attributes      Json?
  isActive        Boolean        @default(true)
  isHidden        Boolean        @default(false)
  labelOverrideEn String?
  labelOverrideAr String?
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization?  @relation(fields: [organizationId], references: [id])
  category        LookupCategory @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, key, organizationId])
  @@index([organizationId])
  @@index([categoryId])
  @@index([layer])
}

// ---------------------------------------------------------------------------
// Working Calendar
// ---------------------------------------------------------------------------

model WorkingCalendar {
  id               String         @id @default(cuid())
  organizationId   String         @unique
  timezone         String         @default("Asia/Riyadh")
  workingDays      Int[]
  workingHoursStart String        @default("08:00")
  workingHoursEnd   String        @default("16:00")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id])
  publicHolidays   PublicHoliday[]
}

model PublicHoliday {
  id                String          @id @default(cuid())
  workingCalendarId String
  nameEn            String
  nameAr            String?
  date              DateTime
  isRecurring       Boolean         @default(false)
  createdAt         DateTime        @default(now())

  workingCalendar   WorkingCalendar @relation(fields: [workingCalendarId], references: [id])

  @@index([workingCalendarId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Organization Units
// ---------------------------------------------------------------------------

model OrgUnit {
  id             String       @id @default(cuid())
  organizationId String
  parentId       String?
  nameEn         String
  nameAr         String?
  code           String
  type           String?
  description    String?
  isActive       Boolean      @default(true)
  isCodeLocked   Boolean      @default(false)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  parent         OrgUnit?     @relation("OrgUnitHierarchy", fields: [parentId], references: [id])
  children       OrgUnit[]    @relation("OrgUnitHierarchy")
  positions      OrgPosition[]
  users          User[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentId])
}

model OrgPosition {
  id             String       @id @default(cuid())
  organizationId String
  orgUnitId      String?
  nameEn         String
  nameAr         String?
  grade          Int
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  orgUnit        OrgUnit?     @relation(fields: [orgUnitId], references: [id])
  users          User[]

  @@index([organizationId])
  @@index([orgUnitId])
  @@unique([organizationId, orgUnitId, nameEn])
}

// ---------------------------------------------------------------------------
// Workflow Engine
// ---------------------------------------------------------------------------

model WorkflowTemplate {
  id             String              @id @default(cuid())
  organizationId String
  nameEn         String
  nameAr         String
  objectType     WorkflowObjectType
  isDefault      Boolean             @default(false)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id])
  stages         WorkflowStage[]
  instances      WorkflowInstance[]

  @@index([organizationId])
  @@index([objectType])
}

model WorkflowStage {
  id                 String                     @id @default(cuid())
  workflowTemplateId String
  nameEn             String
  nameAr             String
  description        String?
  order              Int
  slaWorkingHours    Int?
  requiredPermission String?
  isInitial          Boolean                    @default(false)
  isFinal            Boolean                    @default(false)

  approvalMode       WorkflowApprovalMode       @default(SINGLE)
  parallelThreshold  WorkflowParallelThreshold?
  committeeId        String?

  assigneeStrategy   WorkflowAssigneeStrategy   @default(ROLE)
  assigneeUserId     String?
  assigneeRoleId     String?

  escalationConfig   Json?

  workflowTemplate   WorkflowTemplate           @relation(fields: [workflowTemplateId], references: [id])
  transitionsFrom    WorkflowTransition[]       @relation("TransitionFrom")
  transitionsTo      WorkflowTransition[]       @relation("TransitionTo")
  instanceStages     WorkflowInstanceStage[]

  @@index([workflowTemplateId])
}

model WorkflowTransition {
  id                 String                     @id @default(cuid())
  fromStageId        String
  toStageId          String
  labelEn            String
  labelAr            String
  requiredPermission String?
  triggerCondition   WorkflowTriggerCondition   @default(ROLE_BASED)
  triggerUserId      String?
  triggerRoleId      String?
  validatorConfig    Json?
  isApprovalPath     Boolean                    @default(false)

  fromStage          WorkflowStage              @relation("TransitionFrom", fields: [fromStageId], references: [id])
  toStage            WorkflowStage              @relation("TransitionTo", fields: [toStageId], references: [id])
  actions            WorkflowTransitionAction[]

  @@index([fromStageId])
  @@index([toStageId])
}

model WorkflowInstance {
  id                 String                  @id @default(cuid())
  organizationId     String
  workflowTemplateId String
  objectType         WorkflowObjectType
  objectId           String
  status             WorkflowStatus          @default(PENDING)
  currentStageId     String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  organization       Organization            @relation(fields: [organizationId], references: [id])
  workflowTemplate   WorkflowTemplate        @relation(fields: [workflowTemplateId], references: [id])
  stages             WorkflowInstanceStage[]
  tasks              Task[]
  actionLogs         WorkflowActionLog[]

  @@index([organizationId])
  @@index([workflowTemplateId])
  @@index([objectType, objectId])
  @@index([status])
}

model WorkflowInstanceStage {
  id                 String                        @id @default(cuid())
  workflowInstanceId String
  stageId            String
  enteredAt          DateTime                      @default(now())
  exitedAt           DateTime?
  slaDueAt           DateTime?
  slaBreached        Boolean                       @default(false)
  escalatedRuleIndexes Int[]                        @default([])
  outcome            WorkflowInstanceStageOutcome  @default(PENDING)
  actorId            String?
  comment            String?

  workflowInstance   WorkflowInstance              @relation(fields: [workflowInstanceId], references: [id])
  stage              WorkflowStage                 @relation(fields: [stageId], references: [id])
  approvals          WorkflowApproval[]

  @@index([workflowInstanceId])
  @@index([stageId])
  @@index([slaDueAt])
}

model WorkflowApproval {
  id                      String                    @id @default(cuid())
  workflowInstanceStageId String
  approverId              String
  decision                WorkflowApprovalDecision  @default(PENDING)
  comment                 String?
  decidedAt               DateTime?
  createdAt               DateTime                  @default(now())

  workflowInstanceStage   WorkflowInstanceStage     @relation(fields: [workflowInstanceStageId], references: [id])
  approver                User                      @relation(fields: [approverId], references: [id])

  @@unique([workflowInstanceStageId, approverId])
  @@index([workflowInstanceStageId])
  @@index([approverId])
}

model WorkflowTransitionAction {
  id                   String              @id @default(cuid())
  workflowTransitionId String
  actionType           WorkflowActionType
  order                Int                 @default(0)
  isEnabled            Boolean             @default(true)
  configJson           Json?

  workflowTransition   WorkflowTransition  @relation(fields: [workflowTransitionId], references: [id])
  actionLogs           WorkflowActionLog[]

  @@index([workflowTransitionId])
}

model WorkflowActionLog {
  id                         String                    @id @default(cuid())
  organizationId             String
  workflowTransitionActionId String
  workflowInstanceId         String
  actionType                 WorkflowActionType
  status                     WorkflowActionLogStatus   @default(SUCCESS)
  attemptCount               Int                       @default(1)
  responseSummary            String?
  errorMessage               String?
  executedAt                 DateTime                  @default(now())

  organization               Organization              @relation(fields: [organizationId], references: [id])
  workflowTransitionAction   WorkflowTransitionAction  @relation(fields: [workflowTransitionActionId], references: [id])
  workflowInstance           WorkflowInstance          @relation(fields: [workflowInstanceId], references: [id])

  @@index([organizationId])
  @@index([workflowTransitionActionId])
  @@index([workflowInstanceId])
  @@index([status])
  @@index([executedAt])
}

// ---------------------------------------------------------------------------
// Task Management
// ---------------------------------------------------------------------------

model Task {
  id                   String                @id @default(cuid())
  organizationId       String
  title                String
  description          String?
  sourceType           TaskSourceType
  sourceId             String
  sourceStageId        String?
  workflowInstanceId   String?
  meetingId            String?
  createdById          String
  status               TaskStatus            @default(PENDING)
  priority             TaskPriority          @default(MEDIUM)
  dueAt                DateTime?
  dueDateOverridden    Boolean               @default(false)
  slaBreachedAt        DateTime?
  completedAt          DateTime?
  completedById        String?
  escalationUserId     String?
  escalationAfterHours Int?
  escalatedAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id])
  createdBy            User                  @relation("TaskCreator", fields: [createdById], references: [id])
  workflowInstance      WorkflowInstance?     @relation(fields: [workflowInstanceId], references: [id])
  assignees            TaskAssignee[]
  evidence             TaskEvidence[]

  @@index([organizationId])
  @@index([status])
  @@index([dueAt])
  @@index([sourceType, sourceId])
  @@index([meetingId])
}

model TaskAssignee {
  id           String    @id @default(cuid())
  taskId       String
  userId       String
  assignedAt   DateTime  @default(now())
  assignedById String
  removedAt    DateTime?

  task         Task      @relation(fields: [taskId], references: [id])
  user         User      @relation("TaskAssigneeUser", fields: [userId], references: [id])
  assignedBy   User      @relation("TaskAssigneeAssignedBy", fields: [assignedById], references: [id])

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model TaskEvidence {
  id             String              @id @default(cuid())
  organizationId String
  taskId         String
  type           TaskEvidenceType
  content        String?
  s3Key          String?
  fileName       String?
  fileSize       Int?
  mimeType       String?
  url            String?
  linkTitle      String?
  refType        TaskEvidenceRefType?
  refId          String?
  refDisplay     String?
  uploadedById   String
  uploadedAt     DateTime            @default(now())

  organization   Organization        @relation(fields: [organizationId], references: [id])
  task           Task                @relation(fields: [taskId], references: [id])
  uploadedBy     User                @relation(fields: [uploadedById], references: [id])

  @@index([organizationId])
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  titleEn        String
  titleAr        String?
  bodyEn         String
  bodyAr         String?
  channel        NotificationChannel @default(IN_APP)
  status         NotificationStatus  @default(UNREAD)
  objectType     String?
  objectId       String?
  sentAt         DateTime?
  readAt         DateTime?
  createdAt      DateTime            @default(now())

  organization   Organization        @relation(fields: [organizationId], references: [id])
  user           User                @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Committee Management
// ---------------------------------------------------------------------------

model Committee {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  typeValueId    String
  description    String?
  quorum         Int               @default(0)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id])
  members        CommitteeMember[]
  meetings       Meeting[]

  @@index([organizationId])
}

model CommitteeMember {
  id           String    @id @default(cuid())
  committeeId  String
  userId       String
  roleValueId  String
  joinedAt     DateTime  @default(now())
  leftAt       DateTime?

  committee    Committee @relation(fields: [committeeId], references: [id])
  user         User      @relation(fields: [userId], references: [id])

  @@unique([committeeId, userId])
  @@index([committeeId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Meeting Management
// ---------------------------------------------------------------------------

model Meeting {
  id             String          @id @default(cuid())
  organizationId String
  committeeId    String?
  organizerId    String
  title          String
  typeValueId    String
  scheduledAt    DateTime
  location       String?
  meetingUrl     String?
  status         String          @default("DRAFT")
  minutesText    String?
  minutesApprovedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  committee      Committee?      @relation(fields: [committeeId], references: [id])
  organizer      User            @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  agendaItems    AgendaItem[]

  @@index([organizationId])
  @@index([committeeId])
  @@index([scheduledAt])
}

model AgendaItem {
  id          String   @id @default(cuid())
  meetingId   String
  title       String
  description String?
  order       Int
  duration    Int?
  presenter   String?

  meeting     Meeting  @relation(fields: [meetingId], references: [id])

  @@index([meetingId])
}

// ---------------------------------------------------------------------------
// Audit Log (append-only — no UPDATE or DELETE ever)
// ---------------------------------------------------------------------------

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  actorId        String?
  action         AuditAction
  objectType     String
  objectId       String?
  before         Json?
  after          Json?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  actor          User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([actorId])
  @@index([objectType, objectId])
  @@index([createdAt])
  @@index([action])
}

// ---------------------------------------------------------------------------
// AI Interaction Log — every AI provider call, per CLAUDE.md AI Integration Points
// ("Every AI interaction logged: prompt, model used, response, actor, timestamp")
// ---------------------------------------------------------------------------

model AiInteractionLog {
  id              String   @id @default(cuid())
  organizationId  String
  actorId         String?
  model           String
  feature         String
  promptSummary   String
  responseSummary String?
  durationMs      Int
  success         Boolean
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id])
  actor           User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([actorId])
  @@index([feature])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Better Auth's own identity space (Step 9) — separate from AccreditMe's
// business User model. Linked 1:1 via User.authUserId. Field shapes verified
// directly against the installed better-auth@1.6.22 package's own
// @better-auth/core getAuthTables() output and the twoFactor plugin's own
// schema.ts (backend/Plans/step-09-user-management.md Section 2) — not
// hand-typed from memory. Model names are remapped in better-auth.config.ts
// (Commit 2) via each table's `modelName` option (user -> authUser, etc.)
// so Better Auth's Prisma adapter writes to these exact tables.
//
// AuthUser.email is a tenant-namespaced synthetic value
// ("{organizationId}:{email}"), never shown to a human — the real email
// lives only on User.email. See step-09 plan Section 8 for why.
// ---------------------------------------------------------------------------

model AuthUser {
  id               String    @id @default(cuid())
  name             String              // required by Better Auth's base schema — mirrors User.name at creation, unused by AccreditMe otherwise
  email            String    @unique   // "{organizationId}:{email}" — see above
  emailVerified    Boolean   @default(false)
  image            String?             // unused — part of Better Auth's base user schema
  twoFactorEnabled Boolean   @default(false)   // added by the twoFactor plugin's schema merge
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  appUser          User?
  sessions         AuthSession[]
  accounts         AuthAccount[]
  twoFactor        AuthTwoFactor?
}

model AuthSession {
  id         String   @id @default(cuid())
  expiresAt  DateTime
  token      String   @unique
  ipAddress  String?
  userAgent  String?
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id                    String    @id @default(cuid())
  accountId             String              // == AuthUser.email for the credential provider
  providerId            String              // "credential" — only provider enabled this step
  userId                String
  password              String?             // Argon2id hash for the credential provider (Commit 2)
  // OAuth-only fields below — unused while only the credential provider is
  // enabled, but part of Better Auth's base "account" schema unconditionally;
  // omitting them would break the adapter's generic read/write path.
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model AuthTwoFactor {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  secret                  String             // encrypted at rest by the twoFactor plugin itself (XChaCha20-Poly1305, keyed from Better Auth's own `secret` config) — no custom encryption needed, see Section 12 Discussion 6
  backupCodes             String             // also encrypted by the plugin (storeBackupCodes: "encrypted")
  verified                Boolean  @default(true)
  failedVerificationCount Int      @default(0)
  lockedUntil             DateTime?

  user                    AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Login attempt logging (Step 9) — append-only, same shape as AuditLog.
// Powers account lockout (computed on read, no stored counter), new-IP-login
// detection, and the IP/device audit trail itself.
// ---------------------------------------------------------------------------

model LoginAttempt {
  id             String   @id @default(cuid())
  organizationId String
  email          String             // as typed — may not resolve to a real user
  success        Boolean
  failureReason  String?            // "invalid_password" | "locked" | "no_such_user" | "mfa_failed"
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, email, createdAt])
  @@index([ipAddress])
}

// ---------------------------------------------------------------------------
// Refresh tokens (Step 9) — backs the httpOnly-cookie session model (see
// step-09 plan Section 12, Discussion 4). Never deleted, only revokedAt-stamped
// — same append-only-in-spirit pattern as AuditLog/LoginAttempt, giving a full
// device/session history per user.
// ---------------------------------------------------------------------------

model RefreshToken {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  tokenHash      String    @unique   // SHA-256 hash of the raw token — never store it plain
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?
  deviceInfo     String?             // browser/device string, for security audit
  ipAddress      String?

  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
}
