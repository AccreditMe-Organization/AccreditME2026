# Secrets — never commit
.env
.env.local
.env.*.local
.mcp.json
.claude/settings.local.json

# Backend
backend/node_modules/
backend/dist/
backend/generated/
backend/.env

# Frontend
frontend/node_modules/

# ACC-127 — the Railway IaC SDK is installed beside the authoring file.
# This file uses path-anchored node_modules entries rather than a bare
# `node_modules/`, so a third one needs its own line: without it `.railway/`
# brings in a Windows esbuild.exe. `.railway/package.json` and its lockfile
# ARE committed — they pin the SDK version the authoring file compiles with.
.railway/node_modules/
frontend/dist/
frontend/.angular/

# OS
.DS_Store
Thumbs.db

# Playwright MCP session artifacts
.playwright-mcp/

# ACC-119 — screenshots Playwright writes to the REPOSITORY ROOT.
#
# Not a duplicate of the line above. `--output-dir` governs only
# AUTOMATICALLY named output; the flag's own help says "Files with an explicit
# name are resolved against the workspace root", so a screenshot taken with a
# meaningful filename — which is what a verification pass naturally produces —
# lands here by design and cannot be redirected. On ACC-118 two of them sat
# untracked at the root, one `git add -A` from being committed.
#
# LEADING SLASH, so this matches the root ONLY. Assets under frontend/src are
# untouched; that is the whole reason the pattern is anchored rather than
# global. Verified by `git check-ignore`, not assumed.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp

# ACC-75 — npm audit report written by the CI dependency gate.
# Build artifact, never committed.
audit.json

# Ahmad's own folder — where the Claude desktop app saves documents it
# produces for him. His working material, not project source. Keep it out
# of git; do not delete it.
Claude outputs/
